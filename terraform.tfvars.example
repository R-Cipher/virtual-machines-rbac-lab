# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and replace the placeholders with your own values.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored and must NOT be committed — it holds your
# personal object ID and email.

prefix           = "az104lab"                                # naming prefix for all resources
location         = "eastus"                                  # Azure region to deploy into
operator_object_id = "00000000-0000-0000-0000-000000000000"  # your Entra (Azure AD) user object ID
alert_email      = "you@example.com"                         # email for the budget alert
